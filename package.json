{
  "name": "channex-pms",
  "version": "1.0.0",
  "private": true,
  "description": "Fair-code property management system and channel manager built on the Channex.io API.",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test check:authz check:handlers check:migrations build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test:integration": "turbo run test:integration",
    "db:migrate": "turbo run db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "@types/node": "^22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
