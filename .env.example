# Copy to .env for local development. Values match docker-compose.yml.

# Postgres 16 (tenancy via RLS, spec 13)
DATABASE_URL=postgres://pms:pms@localhost:5432/pms

# Redis 7 (BullMQ queues, pub/sub, rate limiter state)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally): photos, statements, exports
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pms
S3_ACCESS_KEY=pms
S3_SECRET_KEY=pms-secret-change-me

# Channex.io connectivity provider (spec 05). Use staging until certified.
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
# staging (default) | production. Without an API key the in-memory FakeProvider is used.
CHANNEX_ENV=staging
# A staging property id for the certification suite (packages/connectivity/certification).
CHANNEX_STAGING_PROPERTY_ID=

# Deployment mode: development | test | production. Production refuses to start without the keys below.
PMS_ENV=development
# 64 hex chars: `openssl rand -hex 32`. Seals secrets at rest and wraps tenant keys.
PMS_MASTER_KEY=
# 32+ chars: signs 15-minute access tokens.
PMS_SESSION_KEY=

# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Airbnb OAuth (CH-5). Leave unset in development: with PMS_TEST_HOOKS=1 the in-app fake authorisation server is used.
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
AIRBNB_OAUTH_AUTHORIZE_URL=
AIRBNB_OAUTH_TOKEN_URL=
