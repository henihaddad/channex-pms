{
  "name": "@pms/authz",
  "version": "0.0.0",
  "private": true,
  "description": "Permission catalogue and evaluator, generated from spec 02. The single source of authorization truth.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
