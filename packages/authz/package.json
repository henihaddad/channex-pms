    "generate": "tsx scripts/generate.ts",
    "check:authz": "tsx scripts/generate.ts --check"
  },
  "devDependencies": {
    "eslint": "^9",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "@types/node": "^22"
  }
}
