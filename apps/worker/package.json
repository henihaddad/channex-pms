{
  "name": "@pms/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Queue consumers, schedulers and the realtime gateway. Plain Node + BullMQ, never a Next route (spec 14, C3).",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.int.config.ts"
  },
  "dependencies": {
    "@pms/core": "workspace:*",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "zod": "^4.5.4",
    "@pms/db": "workspace:*",
    "@pms/runtime": "workspace:*",
    "@pms/authz": "workspace:*",
    "@pms/connectivity": "workspace:*",
    "@pms/sync": "workspace:*",
    "@pms/jobs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
