{
  "name": "@pms/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js app: staff console, booking engine, guest and owner portals, webhook receiver, public API v1.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:handlers": "tsx ../../scripts/check-handlers.ts",
    "prebuild": "tsx ../../scripts/check-handlers.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "build:cf": "tsx ../../scripts/check-handlers.ts && vite build",
    "preview:cf": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cf": "wrangler deploy --config dist/server/wrangler.json",
    "upload:cf": "wrangler versions upload --config dist/server/wrangler.json --preview-alias next"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pms/authz": "workspace:*",
    "@pms/cloudflare": "workspace:*",
    "@pms/connectivity": "workspace:*",
    "@pms/core": "workspace:*",
    "@pms/db": "workspace:*",
    "@pms/jobs": "workspace:*",
    "@pms/runtime": "workspace:*",
    "@pms/sync": "workspace:*",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "ioredis": "^6.0.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "fast-check": "^4.9.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vinext": "1.4.6",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.164.0"
  }
}
