{
  "name": "@pms/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js app: staff console, booking engine, guest and owner portals, webhook receiver, public API v1.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:handlers": "tsx ../../scripts/check-handlers.ts",
    "prebuild": "tsx ../../scripts/check-handlers.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "build:cf": "PMS_TARGET=cloudflare opennextjs-cloudflare build",
    "preview:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@internationalized/date": "^3.12.4",
    "@opennextjs/cloudflare": "^1.20.6",
    "@pms/authz": "workspace:*",
    "@pms/cloudflare": "workspace:*",
    "@pms/connectivity": "workspace:*",
    "@pms/core": "workspace:*",
    "@pms/db": "workspace:*",
    "@pms/jobs": "workspace:*",
    "@pms/runtime": "workspace:*",
    "@pms/sync": "workspace:*",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-virtual": "^3.13.12",
    "ioredis": "^6.0.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-aria": "^3.52.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
