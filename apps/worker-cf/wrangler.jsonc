{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // ADR-0008: the worker process on Cloudflare. Same queues, same schedule, same processors as apps/worker.
  "name": "otabridge-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "LEASE", "class_name": "PropertyLease" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PropertyLease"] }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "bbdca61d0dbf4a708041624215a6ee3a",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/postgres",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "Q_ARI_PUSH", "queue": "otabridge-ari-push" },
      { "binding": "Q_BOOKING_PROCESS", "queue": "otabridge-booking-process" },
      { "binding": "Q_BOOKING_ACK_SWEEP", "queue": "otabridge-booking-ack-sweep" },
      { "binding": "Q_WEBHOOK_INGEST", "queue": "otabridge-webhook-ingest" },
      { "binding": "Q_MESSAGES_SYNC", "queue": "otabridge-messages-sync" },
      { "binding": "Q_AUTOMATION_RUN", "queue": "otabridge-automation-run" },
      { "binding": "Q_RECONCILE_ARI", "queue": "otabridge-reconcile-ari" },
      { "binding": "Q_REPORTS_BUILD", "queue": "otabridge-reports-build" },
      { "binding": "Q_NOTIFY_DELIVER", "queue": "otabridge-notify-deliver" },
      { "binding": "Q_SYSTEM", "queue": "otabridge-system" },
    ],
    "consumers": [
      {
        "queue": "otabridge-ari-push",
        "max_batch_size": 5,
        "max_retries": 10,
        "dead_letter_queue": "otabridge-dlq",
      },
      {
        "queue": "otabridge-booking-process",
        "max_batch_size": 5,
        "max_retries": 10,
        "dead_letter_queue": "otabridge-dlq",
      },
      {
        "queue": "otabridge-webhook-ingest",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "otabridge-dlq",
      },
      {
        "queue": "otabridge-reconcile-ari",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "otabridge-dlq",
      },
      {
        "queue": "otabridge-messages-sync",
        "max_batch_size": 5,
        "max_retries": 5,
        "dead_letter_queue": "otabridge-dlq",
      },
      {
        "queue": "otabridge-automation-run",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "otabridge-dlq",
      },
      {
        "queue": "otabridge-system",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "otabridge-dlq",
      },
    ],
  },
  "alias": {
    "@node-rs/argon2": "@pms/runtime/shims/argon2",
    "pino": "@pms/runtime/shims/pino",
    "@electric-sql/pglite": "@pms/runtime/shims/pglite",
    "@electric-sql/pglite/contrib/btree_gist": "@pms/runtime/shims/pglite",
    "ioredis": "@pms/runtime/shims/ioredis",
  },
  "vars": {
    "PMS_ENV": "production",
    "PMS_MODE": "hosted",
    "NEXT_PUBLIC_APP_URL": "https://app.otabridge.com",
    "CHANNEX_ENV": "staging",
    "DATABASE_PER_REQUEST": "1",
    "MAIL_TRANSPORT": "resend",
    "LOG_LEVEL": "info",
    "PMS_SELLER_COUNTRY": "PT",
  },
  // Secrets (wrangler secret put): PMS_MASTER_KEY, CHANNEX_API_KEY, RESEND_API_KEY, STRIPE_SECRET_KEY
}
